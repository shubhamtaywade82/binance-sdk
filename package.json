{
  "name": "@nemesis-oss/binance-sdk",
  "version": "3.1.0",
  "description": "TypeScript SDK for Binance APIs (Spot, USD-M Futures, COIN-M Futures, Margin, Wallet, Sub-account) — market data, account, trading, algo orders, user data streams, signed REST + WS APIs (HMAC/Ed25519/RSA), LLM tool layer + MCP server",
  "license": "MIT",
  "author": "Shubham Taywade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/binance-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./spot": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./futures": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ws-api": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./orderbook": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "binance-sdk-mcp": "dist/mcp/index.js"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "binance",
    "futures",
    "usdm",
    "coinm",
    "margin",
    "spot",
    "api",
    "client",
    "crypto",
    "trading",
    "websocket",
    "typescript",
    "mcp",
    "llm"
  ],
  "scripts": {
    "hooks:install": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "prepare": "npm run hooks:install",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:generate": "tsx scripts/generate-endpoint-map.ts",
    "contracts:generate": "tsx scripts/generate-contract-catalog.ts",
    "contracts:check": "tsx scripts/check-contracts-drift.ts",
    "contracts:import-postman": "tsx scripts/import-postman-collections.ts",
    "contracts:generate-from-postman": "tsx scripts/generate-sdk-from-postman.ts",
    "contracts:upstream-drift": "tsx scripts/upstream-drift.ts",
    "contracts:wave6-close-gaps": "tsx scripts/wave6-close-gaps.ts",
    "contracts:wave7-add-schemas": "tsx scripts/wave7-add-schemas.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:testnet": "tsx scripts/testnet-smoke.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:http": "tsx src/mcp/index.ts --http",
    "example:quickstart": "tsx examples/quickstart.ts",
    "example:ws": "tsx examples/ws-streams.ts",
    "example:paper": "tsx examples/paper-trading.ts",
    "example:new-products": "tsx examples/new-products.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "bottleneck": "^2.19.5",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^5.0.1",
    "msw": "^3.0.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
